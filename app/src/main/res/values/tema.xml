<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema.Base: claro aquí, oscuro en values-night. Tema añade la pantalla de arranque en Android 12+ (values-v31). -->
    <style name="Tema.Base" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Tema" parent="Tema.Base" />
</resources>
