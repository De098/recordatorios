<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/w_fondo_claro">
    <LinearLayout android:id="@+id/cab" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/ant" android:layout_width="48dp" android:layout_height="42dp" android:gravity="center" android:text="‹"
            android:textSize="26sp" android:textColor="#241F31" android:background="@drawable/w_boton_claro" android:includeFontPadding="false" android:fontFamily="@font/nunito"/>
        <TextView android:id="@+id/titulo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
            android:textSize="17sp" android:textStyle="bold" android:textColor="#241F31" android:fontFamily="@font/nunito"/>
        <TextView android:id="@+id/sig" android:layout_width="48dp" android:layout_height="42dp" android:gravity="center" android:text="›"
            android:textSize="26sp" android:textColor="#241F31" android:background="@drawable/w_boton_claro" android:includeFontPadding="false" android:fontFamily="@font/nunito"/>
        <TextView android:id="@+id/actualizar" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center"
            android:layout_marginStart="6dp" android:text="↻" android:textSize="22sp" android:textColor="#241F31"
            android:background="@drawable/w_boton_claro" android:includeFontPadding="false" android:fontFamily="@font/nunito"/>
    </LinearLayout>
    <ListView android:id="@+id/lista" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:divider="@null" android:dividerHeight="0dp"/>
    <TextView android:id="@+id/vacio" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="Nada este día" android:textSize="15sp" android:textColor="#6F6A78" android:visibility="gone" android:fontFamily="@font/nunito"/>
</LinearLayout>
