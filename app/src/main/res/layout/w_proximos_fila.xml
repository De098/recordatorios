<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/fila" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
    <ImageView android:id="@+id/barra" android:layout_width="5dp" android:layout_height="38dp" android:src="@drawable/w_barra"
        android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="9dp">
        <TextView android:id="@+id/t" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15dp" android:textColor="#241F31" android:maxLines="2" android:ellipsize="end" android:fontFamily="@font/nunito"/>
        <TextView android:id="@+id/s" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12.5dp" android:textColor="#6F6A78" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/nunito"/>
    </LinearLayout>
    <TextView android:id="@+id/hecho" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="6dp" android:background="@drawable/w_hecho"
        android:text="✓ Hecho" android:textSize="14.5dp" android:textStyle="bold" android:textColor="#FFFFFF" android:visibility="gone" android:fontFamily="@font/nunito"/>
</LinearLayout>
