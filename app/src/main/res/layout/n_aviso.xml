<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso plegado (10-nov, D): letra de la app y botón «✔ Hecho» / «Deshacer» siempre a la vista -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/nt" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="15dp" android:textStyle="bold" android:fontFamily="@font/nunito" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/nx" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="13dp" android:fontFamily="@font/nunito" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/nb" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center"
        android:layout_marginStart="8dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/w_hecho"
        android:text="✓ Hecho" android:textSize="14dp" android:textStyle="bold" android:textColor="#FFFFFF" android:fontFamily="@font/nunito"/>
</LinearLayout>
